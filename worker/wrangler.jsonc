{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhangxinchuang-safe",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PHONE_STATE",
        "class_name": "PhoneState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhoneState"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
